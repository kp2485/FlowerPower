# Swift Package Manager
.build/
.swiftpm/
Package.resolved

# Generated by XcodeGen from project.yml. Never edit these by hand and never
# commit them — the whole point of generating the project is that it cannot
# drift out of step with the files on disk, which is exactly what the
# hand-maintained project did after the 2026 pivot.
#
#     brew install xcodegen && xcodegen generate
#
FlowerPower.xcodeproj/
FlowerPower/Info.plist
FlowerPower/FlowerPower.entitlements
FlowerPowerWatch/Info.plist
FlowerPowerWatch/WidgetInfo.plist
FlowerPowerWatch/FlowerPowerWatch.entitlements
FlowerPowerWatch/FlowerPowerWatchWidget.entitlements
FlowerPowerWidgets/Info.plist
FlowerPowerWidgets/FlowerPowerWidgets.entitlements

# Xcode
xcuserdata/
*.xcuserstate
*.xcscmblueprint
DerivedData/
build/
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# Core ML models are large and are built from a training set rather than
# checked in. See SETUP.md.
*.mlmodelc/

# macOS
.DS_Store

# Windows
Thumbs.db
Desktop.ini

# Agent worktrees created by Claude Code sessions.
.claude/worktrees/

# The identifier is built, not checked in: `tools/bioclip/build.py` produces
# a 300 MB Core ML package and a 44 MB taxon matrix into FlowerPower/Models.
FlowerPower/Models/
tools/bioclip/.venv/
tools/bioclip/work/
