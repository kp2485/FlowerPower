<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  PrivacyInfo.xcprivacy — the widget and Live Activity extension.

  An extension is its own binary and gets its own manifest. This one collects
  nothing. It reads the colony straight out of the App Group save file through
  `GamePersistence` and draws it, and it has no settings of its own, so unlike
  the app it never touches UserDefaults.

  It does declare file timestamps (C617.1), and for a reason worth spelling
  out: `GamePersistence.changeToken()` reads the save file's modification
  date, that code is compiled into every binary that links `FlowerPowerGame`,
  and Apple's check is a static scan of the binary rather than a trace of what
  runs. Whether a widget ever reaches it is beside the point; the call is in
  there. Nothing else is declared because nothing else is true.

  See `FlowerPower/PrivacyInfo.xcprivacy` for the whole reasoning and for
  which required-reason APIs were grepped for.
-->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>C617.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
